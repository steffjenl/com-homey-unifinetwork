{
  "name": "com.ubnt.unifi",
  "version": "2.5.5",
  "main": "app.js",
  "scripts": {
    "build": "homey app build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --forceExit"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.2.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "homey": "^3.7.12",
    "jest": "^29.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "homey-log": "^2.1.0",
    "node-unifi": "^2.5.1",
    "tough-cookie": "^4.1.4",
    "ws": "^8.21.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.homeybuild/"
    ],
    "modulePathIgnorePatterns": [
      "/.homeybuild/"
    ]
  }
}
