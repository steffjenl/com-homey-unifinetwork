{
  "id": "wifi-client",
  "name": {
    "en": "Wifi Client",
    "nl": "Wifi Client",
    "es": "Cliente Wifi",
    "de": "WLAN-Client",
    "fr": "Client Wifi",
    "it": "Client Wifi"
  },
  "mobile": {
    "components": [
      {
        "id": "icon"
      },
      {
        "id": "sensor",
        "capabilities": [
          "connected",
          "measure_signal",
          "measure_rssi",
          "wifi_name",
          "ap",
          "ap_mac",
          "radio_proto",
          "ipAddress",
          "alarm_connected",
          "blocked"
        ],
        "capabilitiesOptions": {
          "onoff": {
            "title": {
              "en": "Connection state",
              "nl": "Verbindingsstatus",
              "es": "Estado de Verbindings",
              "de": "Verbindungsstatus",
              "fr": "État de la connexion",
              "it": "Stato della connessione"
            },
            "getable": true,
            "setable": false
          }
        },
        "options": {
          "icons": {
            "connected": "assets/connected.svg",
            "measure_signal": "assets/signal.svg",
            "measure_rssi": "assets/rssi.svg"
          },
          "connected": {
            "noblink": false,
            "invert": true,
            "label": {
              "true": {
                "en": "Connected",
                "es": "Conectado",
                "de": "Verbunden",
                "fr": "Connecté",
                "it": "Connesso"
              },
              "false": {
                "en": "Disconnected",
                "es": "Desconectado",
                "de": "Getrennt",
                "fr": "Déconnecté",
                "it": "Disconnesso"
              }
            }
          }
        }
      }
    ]
  },
  "images": {
    "large": "drivers/wifi-client/assets/images/large.jpg",
    "small": "drivers/wifi-client/assets/images/small.jpg"
  },
  "class": "sensor",
  "capabilities": [
    "connected",
    "measure_rssi",
    "measure_signal",
    "wifi_name",
    "ap",
    "ap_mac",
    "radio_proto",
    "ipAddress",
    "alarm_connected",
    "blocked"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Connection state",
        "nl": "Verbindingsstatus",
        "es": "Estado de Verbindings",
        "de": "Verbindungsstatus",
        "fr": "État de la connexion",
        "it": "Stato della connessione"
      },
      "getable": true,
      "setable": false
    }
  },
  "pair": [
    {
      "id": "list_clients",
      "template": "list_devices",
      "navigation": {
        "next": "add_clients"
      }
    },
    {
      "id": "add_clients",
      "template": "add_devices"
    }
  ]
}
