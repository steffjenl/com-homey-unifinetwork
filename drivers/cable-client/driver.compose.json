{
  "id": "cable-client",
  "name": {
    "en": "Wired client",
    "nl": "Bedrade cliënt",
    "es": "Cliente cableado",
    "de": "Verkabelter Client",
    "fr": "Client câblé",
    "it": "Client cablato"
  },
  "mobile": {
    "components": [
      {
        "id": "icon"
      },
      {
        "id": "sensor",
        "capabilities": [
          "onoff",
          "connected",
          "blocked"
        ],
        "capabilitiesOptions": {
          "onoff": {
            "title": {
              "en": "Connection state",
              "nl": "Verbindingsstatus",
              "es": "Estado de Verbindings",
              "de": "Verbindungsstatus",
              "fr": "État de la connexion",
              "it": "Stato della connessione"
            }
          },
          "getable": true,
          "setable": false
        },
        "options": {
          "icons": {
            "connected": "assets/connected.svg"
          },
          "connected": {
            "noblink": false,
            "invert": true,
            "label": {
              "true": {
                "en": "Connected",
                "es": "Conectado",
                "de": "Verbunden",
                "fr": "Connecté",
                "it": "Connesso"
              },
              "false": {
                "en": "Disconnected",
                "es": "Desconectado",
                "de": "Getrennt",
                "fr": "Déconnecté",
                "it": "Disconnesso"
              }
            }
          }
        }
      }
    ]
  },
  "images": {
    "large": "drivers/cable-client/assets/images/large.jpg",
    "small": "drivers/cable-client/assets/images/small.jpg"
  },
  "class": "sensor",
  "capabilities": [
    "onoff",
    "connected",
    "blocked"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Connection state",
        "nl": "Verbindingsstatus",
        "es": "Estado de Verbindings",
        "de": "Verbindungsstatus",
        "fr": "État de la connexion",
        "it": "Stato della connessione"
      },
      "getable": true,
      "setable": false
    }
  },
  "pair": [
    {
      "id": "list_clients",
      "template": "list_devices",
      "navigation": {
        "next": "add_clients"
      }
    },
    {
      "id": "add_clients",
      "template": "add_devices"
    }
  ]
}
